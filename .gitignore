# macOS
.DS_Store

# Xcode — per-user state (window layout, breakpoints, schemes you haven't shared)
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Build output
build/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
# Keep Package.resolved committed so everyone builds the same dependency versions

# Secrets / local config (API keys should never be committed)
*.xcconfig.local
Secrets.xcconfig
.env

# XcodeGen output — regenerate with `xcodegen generate` (project.yml is the source of truth)
*.xcodeproj/
DockNearby/Info.plist
DockNearby/DockNearby.entitlements
DockWidget/Info.plist
DockWidget/DockWidget.entitlements

# Personal phone screenshots used by the App Store screenshot generator (wallpaper, carrier, badges),
# and the generated slides that include them — regenerate with `swift Design/make-screenshots.swift`
Design/screenshots/device/
Design/screenshots/appstore/
